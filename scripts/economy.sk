# SkriptForge — Lightweight Economy
# Minecraft 1.8.8 / legacy Skript syntax

command /balance [<player>]:
    aliases: /bal
    trigger:
        if arg-1 is set:
            send "&a%arg-1%'s balance: &e$%{skriptforge.money::%uuid of arg-1%}%"
        else:
            if {skriptforge.money::%uuid of player%} is not set:
                set {skriptforge.money::%uuid of player%} to 0
            send "&aYour balance: &e$%{skriptforge.money::%uuid of player%}%"

command /pay <player> <number>:
    trigger:
        if arg-2 <= 0:
            send "&cAmount must be greater than zero."
            stop
        if {skriptforge.money::%uuid of player%} is not set:
            set {skriptforge.money::%uuid of player%} to 0
        if {skriptforge.money::%uuid of player%} < arg-2:
            send "&cYou don't have enough money."
            stop
        remove arg-2 from {skriptforge.money::%uuid of player%}
        add arg-2 to {skriptforge.money::%uuid of arg-1%}
        send "&aYou paid &e$%arg-2% &ato &e%arg-1%&a."
        send "&aYou received &e$%arg-2% &afrom &e%player%&a." to arg-1

command /setmoney <player> <number>:
    permission: skriptforge.economy.admin
    permission message: &cYou don't have permission.
    trigger:
        set {skriptforge.money::%uuid of arg-1%} to arg-2
        send "&aSet &e%arg-1%'s &abalance to &e$%arg-2%&a."
