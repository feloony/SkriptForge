# SkriptForge — Home System
# Minecraft 1.8.8 / Skript 2.2 compatible

command /sethome:
    trigger:
        set {skriptforge.home.%player%} to location of player
        send "&aHome set successfully."

command /home:
    trigger:
        if {skriptforge.home.%player%} is not set:
            send "&cYou have not set a home yet. Use &e/sethome&c."
            stop
        send "&7Teleporting home..."
        wait 2 seconds
        teleport player to {skriptforge.home.%player%}
        send "&aWelcome home!"

command /delhome:
    trigger:
        if {skriptforge.home.%player%} is not set:
            send "&cYou don't have a home set."
            stop
        delete {skriptforge.home.%player%}
        send "&aYour home has been deleted."
